# --- AI Gateway (embeddings) ---
# Preferred on Vercel: link the project, enable AI Gateway, then:
#   vercel env pull .env.local
# That provisions VERCEL_OIDC_TOKEN (~24h locally; auto on Vercel).
#
# Or create a static key in the Vercel dashboard:
#   Project → AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# OIDC token from `vercel env pull` (optional if AI_GATEWAY_API_KEY is set)
VERCEL_OIDC_TOKEN=

# --- Upstash Redis (embedding cache; replaces @vercel/kv) ---
# Marketplace (recommended):
#   vercel integration add upstash
# Then pull envs again. Or copy from Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV names still work as fallbacks if you already have them:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- App / cron ---
CRON_SECRET=
NEXT_PUBLIC_URL=http://localhost:3000
